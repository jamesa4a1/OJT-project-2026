# ============================================
# ENVIRONMENT VARIABLES - SECURITY CRITICAL
# ============================================
# 
# IMPORTANT: Copy this file to .env.development or .env.production
# NEVER commit actual .env files to version control
#
# Generate secure secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================

# ============================================
# DATABASE CONFIGURATION
# ============================================
# CRITICAL: Use strong, unique passwords in production!

DB_HOST=localhost
DB_USER=ocp_app
DB_PASSWORD=your_very_secure_password_here_change_this
DB_NAME=ocp_docketing
DB_PORT=3306

# Connection pool settings
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=10000

# ============================================
# APPLICATION SETTINGS
# ============================================

NODE_ENV=development
PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ============================================
# JWT / AUTHENTICATION
# ============================================
# CRITICAL: Generate unique secrets for production!

# Main JWT secret (32+ characters required)
JWT_SECRET=your_super_secret_jwt_key_change_this_min_32_chars

# Optional: Separate secret for refresh tokens (recommended)
JWT_REFRESH_SECRET=your_refresh_token_secret_change_this_min_32_chars

# Token expiration times
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============================================
# ADMIN ACCOUNT
# ============================================
# First login admin credentials
# IMPORTANT: Change password immediately after first login

ADMIN_DEFAULT_PASSWORD=ChangeMe@123456789!

# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated list of allowed origins
# In production, only include your actual frontend domains

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ============================================
# RATE LIMITING
# ============================================

# General API rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Login rate limit (stricter)
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# Account lockout settings
LOCKOUT_THRESHOLD=5
LOCKOUT_DURATION_MINUTES=15

# ============================================
# SESSION / COOKIE SETTINGS
# ============================================

SESSION_SECRET=your_session_secret_change_this_min_32_chars
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ============================================
# SECURITY SETTINGS
# ============================================

# Enable security logging to database
ENABLE_DB_SECURITY_LOGGING=true

# Security log retention (days)
SECURITY_LOG_RETENTION_DAYS=90

# Enable input sanitization
ENABLE_INPUT_SANITIZATION=true

# Enable SQL injection detection
ENABLE_SQL_INJECTION_DETECTION=true

# Enable XSS detection
ENABLE_XSS_DETECTION=true

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
# Used for password reset, security alerts, etc.

EMAIL_ENABLED=false
EMAIL_FROM=noreply@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Send security alerts to admin
SECURITY_ALERT_EMAIL=admin@yourdomain.com

# ============================================
# LOGGING
# ============================================

LOG_LEVEL=info
LOG_FORMAT=json
LOG_TO_FILE=true
LOG_MAX_SIZE=10MB
LOG_MAX_FILES=30

# ============================================
# FILE UPLOAD SETTINGS
# ============================================

MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpeg,jpg,png,gif,webp,pdf
UPLOAD_PATH=./uploads

# ============================================
# BACKUP SETTINGS (Optional)
# ============================================

BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./backups

# ============================================
# PRODUCTION CHECKLIST
# ============================================
# Before deploying to production, ensure:
#
# [ ] All secrets are unique and strong (32+ chars)
# [ ] DB_PASSWORD is not empty or weak
# [ ] JWT_SECRET is cryptographically random
# [ ] ALLOWED_ORIGINS only contains your domains
# [ ] NODE_ENV=production
# [ ] HTTPS is enabled (via reverse proxy)
# [ ] Database user has minimal required privileges
# [ ] Security headers are enabled
# [ ] Rate limiting is configured
# [ ] Logging is enabled
# [ ] Backup schedule is configured
#
# ============================================
#    - .env.production (for production)
# 6. Ensure all required variables are set before starting the application
# 
# ============================================
