# ============================================
# ENVIRONMENT VARIABLES - SECURITY CRITICAL
# ============================================

# Database Configuration (CHANGE THESE IN PRODUCTION)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_secure_password_here
DB_NAME=ocp_docketing

# Admin Account (Change this password immediately after first login)
ADMIN_DEFAULT_PASSWORD=ChangeMe@123456

# Application
NODE_ENV=development
PORT=5000

# JWT Secret (Generate a secure random string for production)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Email Configuration (if needed)
EMAIL_FROM=noreply@ojt-project.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Logging
LOG_LEVEL=info

# Session Configuration
SESSION_SECRET=your_session_secret_change_this

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# IMPORTANT SECURITY NOTES
# ============================================
# 
# 1. NEVER commit .env file to version control
# 2. Use strong, unique passwords for production
# 3. Generate strong JWT_SECRET using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 4. Change ADMIN_DEFAULT_PASSWORD immediately after first login
# 5. Use environment-specific .env files:
#    - .env.development (for development)
#    - .env.production (for production)
# 6. Ensure all required variables are set before starting the application
# 
# ============================================
